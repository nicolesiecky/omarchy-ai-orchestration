#!/bin/bash

# omarchy:summary=Regenerate the AI agent usage data files
# omarchy:args=[--force] [--limits-only] [--except <agent>] [agent...]

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
mkdir -p "$USAGE_DIR"

flags=()
only=()
declare -A excluded

# Automatically respect disabled providers from shell.json
if [[ -f "$HOME/.config/omarchy/shell.json" ]]; then
  for disabled in $(jq -r '.. | objects | select(.id == "omarchy.agents") | .providers // {} | to_entries[] | select(.value.enabled == false) | .key' "$HOME/.config/omarchy/shell.json" 2>/dev/null); do
    excluded["$disabled"]=1
  done
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  local record tmp
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "omarchy-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

pids=()
declare -A seen
for dir in "$HOME/.local/bin" "${OMARCHY_PATH:-/usr/share/omarchy}/bin"; do
  [[ -d $dir ]] || continue
  for collector in "$dir"/omarchy-agent-usage-*; do
    [[ -x $collector ]] || continue
    agent="${collector##*/omarchy-agent-usage-}"
    [[ $agent == "update" ]] && continue
    [[ -n ${seen[$agent]} ]] && continue
    seen[$agent]=1
    wanted "$agent" || continue
    collect "$collector" "$agent" &
    pids+=($!)
  done
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
