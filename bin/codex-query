#!/usr/bin/env python3
"""Run non-interactive queries against Codex with Herdr Swarm integration and fallback."""
import os
import sys
import json
import shutil
import subprocess

def try_herdr_agent(prompt: str) -> bool:
    """Try querying the running 'architect' agent inside Herdr if available."""
    if not shutil.which("herdr"):
        return False
    try:
        check = subprocess.run(
            ["herdr", "agent", "get", "architect"],
            capture_output=True,
            text=True,
            timeout=3
        )
        if check.returncode != 0:
            return False
        data = json.loads(check.stdout)
        status = data.get("result", {}).get("agent", {}).get("agent_status")
        if status not in ("idle", "done"):
            return False

        res = subprocess.run(
            ["herdr", "agent", "prompt", "architect", prompt, "--wait", "--timeout", "45000"],
            capture_output=True,
            text=True,
            timeout=50
        )
        if res.returncode == 0:
            read_res = subprocess.run(
                ["herdr", "agent", "read", "architect", "--source", "recent-unwrapped", "--lines", "100"],
                capture_output=True,
                text=True,
                timeout=5
            )
            if read_res.stdout.strip():
                print(read_res.stdout.strip())
                return True
    except Exception:
        pass
    return False

def main():
    if len(sys.argv) < 2:
        print("Usage: codex-query <prompt>", file=sys.stderr)
        sys.exit(1)

    prompt = " ".join(sys.argv[1:])

    # 1. Try Herdr Swarm 'architect' if running in active workspace
    if try_herdr_agent(prompt):
        return 0

    # 2. Direct Codex standalone binary execution
    codex_bin = shutil.which("codex")
    if codex_bin:
        try:
            res = subprocess.run(
                [codex_bin, "exec", "--skip-git-repo-check", prompt],
                capture_output=True,
                text=True,
                timeout=30
            )
            output = (res.stdout or "") + (res.stderr or "")
            if "usage limit" not in output.lower() and "error" not in output.lower() and res.returncode == 0:
                print(res.stdout)
                return 0
        except Exception:
            pass

    # 3. Fallback to agy (Flash) if Codex is unavailable or out of quota
    agy_bin = shutil.which("agy")
    if agy_bin:
        try:
            res = subprocess.run(
                [agy_bin, "-p", prompt, "--model", "gemini-3.8-flash-high"],
                capture_output=True,
                text=True,
                timeout=30
            )
            print(res.stdout)
            return res.returncode
        except Exception as e:
            print(f"Error during fallback: {e}", file=sys.stderr)
            return 1

    print("No available agent CLI backend.", file=sys.stderr)
    return 1

if __name__ == "__main__":
    sys.exit(main())
