#!/usr/bin/env python3
"""Run non-interactive queries against Codex with fallback."""
import json
import subprocess
import sys
import shutil

def main():
    if len(sys.argv) < 2:
        print("Usage: codex-query <prompt>", file=sys.stderr)
        sys.exit(1)

    prompt = " ".join(sys.argv[1:])

    codex_bin = shutil.which("codex")
    if codex_bin:
        try:
            res = subprocess.run(
                [codex_bin, "exec", "--skip-git-repo-check", prompt],
                capture_output=True,
                text=True,
                timeout=30
            )
            # Check for common quota / limit errors
            output = (res.stdout or "") + (res.stderr or "")
            if "usage limit" not in output.lower() and "error" not in output.lower() and res.returncode == 0:
                print(res.stdout)
                return 0
        except Exception:
            pass

    # Fallback to agy (Flash) if Codex is unavailable or out of quota
    agy_bin = shutil.which("agy")
    if agy_bin:
        try:
            res = subprocess.run(
                [agy_bin, "-p", prompt, "--model", "gemini-3.8-flash-high"],
                capture_output=True,
                text=True,
                timeout=30
            )
            print(res.stdout)
            return res.returncode
        except Exception as e:
            print(f"Error during fallback: {e}", file=sys.stderr)
            return 1

    print("No available agent CLI backend.", file=sys.stderr)
    return 1

if __name__ == "__main__":
    sys.exit(main())
