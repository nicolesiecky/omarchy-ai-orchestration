#!/usr/bin/env python3
"""Safe, workspace-aware orchestration CLI for Herdr agents."""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Iterable

DEFAULT_TIMEOUT = 30
MAX_TIMEOUT = 3600
JSON_MODE = False


class CommandFailure(Exception):
    def __init__(self, code: str, message: str, *, details: Any = None, exit_code: int = 1):
        super().__init__(message)
        self.code, self.message, self.details, self.exit_code = code, message, details, exit_code


def emit(ok: bool, command: str, *, result: Any = None, error: CommandFailure | None = None) -> int:
    if JSON_MODE:
        payload: dict[str, Any] = {"ok": ok, "command": command}
        if ok:
            payload["result"] = result
        elif error:
            payload["error"] = {"code": error.code, "message": error.message}
            if error.details is not None:
                payload["error"]["details"] = error.details
        print(json.dumps(payload, ensure_ascii=False))
    elif ok:
        if isinstance(result, str):
            print(result)
        elif result is not None:
            print(json.dumps(result, ensure_ascii=False, indent=2))
    elif error:
        print(f"Error [{error.code}]: {error.message}", file=sys.stderr)
        if error.details:
            print(str(error.details), file=sys.stderr)
    return 0 if ok else (error.exit_code if error else 1)


def bounded_run(args: Iterable[str], timeout: float = DEFAULT_TIMEOUT, *, check: bool = False,
                cwd: str | None = None, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    """Run a subprocess with a hard timeout and normalized failures."""
    argv = list(args)
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=max(1, min(float(timeout), MAX_TIMEOUT)), cwd=cwd, input=input_text)
    except subprocess.TimeoutExpired as exc:
        output = exc.stdout or ""
        if isinstance(output, bytes):
            output = output.decode(errors="replace")
        raise CommandFailure("timeout", f"Command timed out after {timeout}s: {argv[0]}", details=output or None, exit_code=124) from exc
    except FileNotFoundError as exc:
        raise CommandFailure("not_found", f"Required executable not found: {argv[0]}", details=str(exc), exit_code=127) from exc
    except OSError as exc:
        raise CommandFailure("os_error", f"Could not run {argv[0]}", details=str(exc), exit_code=126) from exc
    if check and result.returncode:
        raise CommandFailure("subprocess_failed", f"Command exited with status {result.returncode}: {argv[0]}", details=(result.stderr or result.stdout).strip(), exit_code=result.returncode)
    return result


def herdr_json(*args: str, timeout: float = DEFAULT_TIMEOUT) -> Any:
    result = bounded_run(["herdr", *args], timeout)
    if result.returncode:
        raise CommandFailure("herdr_failed", f"herdr {' '.join(args)} failed ({result.returncode})", details=(result.stderr or result.stdout).strip(), exit_code=result.returncode)
    raw = result.stdout.strip()
    if not raw:
        return ""
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return raw


def output_text(value: Any) -> str:
    if isinstance(value, str):
        return value.strip()
    return json.dumps(value, ensure_ascii=False) if value is not None else ""


def get_agents(timeout: float = DEFAULT_TIMEOUT) -> list[dict[str, Any]]:
    data = herdr_json("agent", "list", timeout=timeout)
    if isinstance(data, dict):
        agents = data.get("result", {}).get("agents", [])
        if isinstance(agents, list):
            return [a for a in agents if isinstance(a, dict)]
    raise CommandFailure("invalid_response", "herdr agent list returned an unexpected response", details=data)


def current_workspace(agents: list[dict[str, Any]]) -> str | None:
    explicit = os.environ.get("HERDR_WORKSPACE") or os.environ.get("HERDR_WORKSPACE_ID")
    if explicit:
        return explicit
    try:
        current = herdr_json("workspace", "current", "--json", timeout=5)
        if isinstance(current, dict):
            info = current.get("result", current)
            if isinstance(info, dict):
                workspace = info.get("workspace_id") or info.get("id") or info.get("name")
                if workspace:
                    return str(workspace)
    except CommandFailure:
        pass
    cwd = str(Path.cwd().resolve())
    candidates: list[tuple[int, str]] = []
    for agent in agents:
        workspace = agent.get("workspace_id") or agent.get("workspace")
        root = agent.get("workspace_path") or agent.get("workspace_root") or agent.get("cwd")
        if workspace and root:
            try:
                root_resolved = str(Path(root).resolve())
                if cwd == root_resolved or cwd.startswith(root_resolved + os.sep):
                    candidates.append((len(root_resolved), str(workspace)))
            except (OSError, TypeError):
                continue
    if candidates:
        return max(candidates)[1]
    ids = [str(a.get("workspace_id")) for a in agents if a.get("workspace_id")]
    return ids[0] if ids and len(set(ids)) == 1 else None


def filter_workspace(agents: list[dict[str, Any]], workspace: str | None) -> list[dict[str, Any]]:
    if workspace is None:
        return agents
    return [a for a in agents if str(a.get("workspace_id") or a.get("workspace") or "") == workspace]


def find_agent(data: Any) -> dict[str, Any] | None:
    if not isinstance(data, dict):
        return None
    result = data.get("result", data)
    if isinstance(result, dict):
        agent = result.get("agent", result)
        return agent if isinstance(agent, dict) else None
    return None


def cmd_status(args: argparse.Namespace) -> int:
    try:
        agents = get_agents()
        workspace = args.workspace or current_workspace(agents)
        if workspace is None and len({str(a.get("workspace_id") or a.get("workspace") or "") for a in agents}) > 1:
            raise CommandFailure("workspace_ambiguous", "Could not determine the current workspace; pass --workspace to avoid cross-workspace results")
        scoped = filter_workspace(agents, workspace)
        rows = [{"name": a.get("name") or a.get("agent") or "unknown", "engine": a.get("agent", "unknown"),
                 "workspace_id": a.get("workspace_id", ""), "tab_id": a.get("tab_id", ""),
                 "pane_id": a.get("pane_id", ""), "status": a.get("agent_status", a.get("status", "unknown"))}
                for a in sorted(scoped, key=lambda x: (str(x.get("tab_id", "")), str(x.get("name", ""))))]
        if JSON_MODE:
            return emit(True, "status", result={"workspace": workspace, "agents": rows})
        if not rows:
            return emit(True, "status", result="No active agents found in the selected workspace.")
        print(f"Workspace: {workspace or 'all (workspace unavailable)'}")
        print(f"{'Name':<18} {'Engine':<15} {'Tab':<10} {'Pane':<12} Status")
        for row in rows:
            print(f"{row['name']:<18} {row['engine']:<15} {row['tab_id']:<10} {row['pane_id']:<12} {row['status']}")
        return 0
    except CommandFailure as exc:
        return emit(False, "status", error=exc)


def preflight_agent(target: str, timeout: float) -> dict[str, Any]:
    data = herdr_json("agent", "get", target, timeout=timeout)
    agent = find_agent(data)
    if not agent:
        raise CommandFailure("agent_not_found", f"Could not resolve Herdr agent: {target}", details=data)
    agents = get_agents(timeout)
    workspaces = {str(a.get("workspace_id") or a.get("workspace") or "") for a in agents}
    workspace = current_workspace(agents)
    if workspace is None and len(workspaces - {""}) > 1:
        raise CommandFailure("workspace_ambiguous", f"Could not determine current workspace before targeting {target}; set HERDR_WORKSPACE")
    agent_workspace = agent.get("workspace_id") or agent.get("workspace")
    if workspace and agent_workspace and str(agent_workspace) != workspace:
        raise CommandFailure("workspace_mismatch", f"Agent {target} resolved outside the current workspace", details={"current": workspace, "agent_workspace": agent_workspace})
    matches = [a for a in filter_workspace(agents, workspace) if target in {str(a.get("name", "")), str(a.get("agent", "")), str(a.get("pane_id", ""))}]
    if workspace and not matches:
        raise CommandFailure("agent_not_in_workspace", f"Agent {target} is not present in workspace {workspace}")
    if len(matches) > 1:
        raise CommandFailure("agent_ambiguous", f"Agent target {target} is ambiguous in workspace {workspace}")
    return agent


def wait_agent_idle(target: str, timeout: float, until: str = "idle") -> str:
    result = bounded_run(["herdr", "agent", "wait", target, "--until", until, "--timeout", str(int(timeout * 1000))], timeout + 2)
    if result.returncode:
        raise CommandFailure("wait_failed", f"Waiting for {target} failed ({result.returncode})", details=(result.stderr or result.stdout).strip(), exit_code=result.returncode)
    return result.stdout.strip()


def cmd_prompt(args: argparse.Namespace) -> int:
    target, timeout = args.agent, args.timeout
    try:
        agent = preflight_agent(target, min(timeout, 30))
        status = str(agent.get("agent_status", agent.get("status", "unknown"))).lower()
        if status not in {"idle", "done"}:
            wait_agent_idle(target, timeout, "idle")
        command = ["herdr", "agent", "prompt", target, args.prompt_text]
        if args.wait:
            command.extend(["--wait", "--timeout", str(int(timeout * 1000))])
        dispatched = bounded_run(command, timeout + 5)
        if dispatched.returncode:
            raise CommandFailure("prompt_failed", f"Prompt dispatch failed ({dispatched.returncode})", details=(dispatched.stderr or dispatched.stdout).strip(), exit_code=dispatched.returncode)
        response = dispatched.stdout.strip()
        if args.wait:
            read = bounded_run(["herdr", "agent", "read", target, "--source", "recent-unwrapped", "--lines", "120"], min(timeout, 60))
            if read.returncode:
                raise CommandFailure("read_failed", f"Prompt ran but reading its output failed ({read.returncode})", details=(read.stderr or read.stdout).strip(), exit_code=read.returncode)
            response = read.stdout.strip() or response
            if not response:
                raise CommandFailure("empty_output", f"Agent {target} returned no output")
        return emit(True, "prompt", result={"agent": target, "status": "dispatched", "output": response})
    except CommandFailure as exc:
        return emit(False, "prompt", error=exc)


def cmd_read(args: argparse.Namespace) -> int:
    try:
        result = bounded_run(["herdr", "agent", "read", args.agent, "--source", args.source, "--lines", str(args.lines)], DEFAULT_TIMEOUT)
        if result.returncode:
            raise CommandFailure("read_failed", f"Reading {args.agent} failed ({result.returncode})", details=(result.stderr or result.stdout).strip(), exit_code=result.returncode)
        return emit(True, "read", result={"agent": args.agent, "source": args.source, "output": result.stdout.strip()})
    except CommandFailure as exc:
        return emit(False, "read", error=exc)


def cmd_wait(args: argparse.Namespace) -> int:
    try:
        output = wait_agent_idle(args.agent, args.timeout, args.until)
        return emit(True, "wait", result={"agent": args.agent, "until": args.until, "output": output})
    except CommandFailure as exc:
        return emit(False, "wait", error=exc)


def simple_herdr(command: str, argv: list[str], *, timeout: float = DEFAULT_TIMEOUT, fallback: list[str] | None = None) -> int:
    try:
        result = bounded_run(["herdr", *argv], timeout)
        if result.returncode and fallback:
            result = bounded_run(["herdr", *fallback], timeout)
        if result.returncode:
            raise CommandFailure("herdr_failed", result.stderr.strip() or result.stdout.strip() or f"herdr command exited {result.returncode}", exit_code=result.returncode)
        return emit(True, command, result=result.stdout.strip() or {"ok": True})
    except CommandFailure as exc:
        return emit(False, command, error=exc)


def cmd_interrupt(args: argparse.Namespace) -> int:
    return simple_herdr("interrupt", ["agent", "interrupt", args.agent])


def cmd_focus(args: argparse.Namespace) -> int:
    target = args.agent_or_tab
    return simple_herdr("focus", ["agent", "focus", target], fallback=["tab", "focus", target])


def cmd_zoom(args: argparse.Namespace) -> int:
    target = args.agent_or_pane
    try:
        data = herdr_json("agent", "get", target)
        agent = find_agent(data)
        pane = str((agent or {}).get("pane_id") or target)
        return simple_herdr("zoom", ["pane", "zoom", "--pane", pane, "--toggle"])
    except CommandFailure as exc:
        return emit(False, "zoom", error=exc)


def cmd_broadcast(args: argparse.Namespace) -> int:
    agents = ["builder", "craftsman", "architect"]
    failures: list[dict[str, Any]] = []
    delivered: list[str] = []
    for agent in agents:
        try:
            result = bounded_run(["herdr", "agent", "prompt", agent, args.text], args.timeout)
            if result.returncode:
                failures.append({"agent": agent, "exit_code": result.returncode, "message": (result.stderr or result.stdout).strip()})
            else:
                delivered.append(agent)
        except CommandFailure as exc:
            failures.append({"agent": agent, "code": exc.code, "message": exc.message})
    data = {"delivered": delivered, "failures": failures}
    if failures:
        return emit(False, "broadcast", error=CommandFailure("partial_failure", "Broadcast failed for one or more agents", details=data))
    return emit(True, "broadcast", result=data)


def prompt_and_read(agent: str, prompt: str, timeout: float, *, require_output: bool = True) -> str:
    ns = argparse.Namespace(agent=agent, prompt_text=prompt, timeout=timeout, wait=True)
    # Keep stage behavior centralized in cmd_prompt and preserve its error code.
    try:
        state = preflight_agent(agent, min(timeout, 30))
        if str(state.get("agent_status", state.get("status", "unknown"))).lower() not in {"idle", "done"}:
            wait_agent_idle(agent, timeout, "idle")
        sent = bounded_run(["herdr", "agent", "prompt", agent, prompt, "--wait", "--timeout", str(int(timeout * 1000))], timeout + 5)
        if sent.returncode:
            raise CommandFailure("prompt_failed", f"{agent} stage failed ({sent.returncode})", details=(sent.stderr or sent.stdout).strip(), exit_code=sent.returncode)
        read = bounded_run(["herdr", "agent", "read", agent, "--source", "recent-unwrapped", "--lines", "120"], min(timeout, 60))
        if read.returncode:
            raise CommandFailure("read_failed", f"Could not read {agent} output", details=(read.stderr or read.stdout).strip(), exit_code=read.returncode)
        output = read.stdout.strip() or sent.stdout.strip()
        if require_output and not output:
            raise CommandFailure("empty_output", f"{agent} returned empty output")
        return output
    except CommandFailure:
        raise


def cmd_pipeline(args: argparse.Namespace) -> int:
    task, timeout = args.task, args.timeout
    stages = [
        ("architect", f"TASK: {task}\n\nOutline architectural contracts, interfaces, data types and adversarial edge cases. Return concise actionable guidance."),
        ("builder", None),
        ("sentinel", f"Run unit tests and syntax checks for this task: {task}. Report exact pass/fail counts and failures."),
        ("reviewer", f"Perform a strict code and security review of the implementation for: {task}. Report findings and verdict."),
    ]
    outputs: dict[str, str] = {}
    for index, (agent, prompt) in enumerate(stages, 1):
        if agent == "builder":
            arch = outputs.get("architect", "").strip()
            if not arch:
                return emit(False, "pipeline", error=CommandFailure("empty_architecture", "Architect output is required before builder stage"))
            prompt = f"TASK: {task}\n\nARCHITECTURE CONTRACTS:\n{arch}\n\nImplement the required changes and tests."
        print(f"[Stage {index}/{len(stages)}] {agent}", file=sys.stderr)
        try:
            outputs[agent] = prompt_and_read(agent, prompt or "", timeout)
        except CommandFailure as exc:
            return emit(False, "pipeline", error=CommandFailure(f"stage_{agent}_{exc.code}", f"Pipeline stopped at {agent}: {exc.message}", details=exc.details, exit_code=exc.exit_code))
    return emit(True, "pipeline", result={"stages": outputs, "completed": list(outputs)})


def require_tool(name: str) -> str:
    path = shutil.which(name)
    if not path:
        raise CommandFailure("tool_missing", f"Required frontend verification tool is missing: {name}")
    return path


def cmd_frontend(args: argparse.Namespace) -> int:
    topic, timeout = args.topic, args.timeout
    kind, page_type = args.kind, args.type
    try:
        scout = bounded_run(["inspiration-scout", topic, kind, page_type], timeout)
        if scout.returncode:
            raise CommandFailure("scout_failed", "Inspiration scout failed", details=(scout.stderr or scout.stdout).strip(), exit_code=scout.returncode)
        dossier = scout.stdout.strip()
        if not dossier:
            raise CommandFailure("empty_dossier", "Inspiration scout returned empty output")
        dossier_path = Path("INSPIRATION_DOSSIER.md").resolve()
        dossier_path.write_text(dossier + "\n", encoding="utf-8")
        arch = prompt_and_read("architect", f"Frontend topic: {topic}\nRead {dossier_path}. Return a concrete implementation plan with layout, design tokens and responsive behavior.", timeout)
        build = prompt_and_read("builder", f"Implement frontend for {topic}. Use dossier at {dossier_path} and this plan:\n{arch}\nFollow responsive and accessibility constraints.", timeout)
        impeccable = require_tool("impeccable")
        taste = require_tool("taste-skill")
        detect = bounded_run([impeccable, "detect", "--json", "."], timeout)
        if detect.returncode:
            raise CommandFailure("impeccable_failed", "Impeccable verification failed; frontend pipeline stopped", details=(detect.stderr or detect.stdout).strip(), exit_code=detect.returncode)
        files = bounded_run(["find", ".", "-maxdepth", "3", "-type", "f", "-name", "*.html", "-print"], timeout)
        if files.returncode:
            raise CommandFailure("discovery_failed", "Could not locate HTML for TasteSkill", details=(files.stderr or files.stdout).strip(), exit_code=files.returncode)
        html_files = [line.strip() for line in files.stdout.splitlines() if line.strip()]
        if not html_files:
            raise CommandFailure("html_missing", "TasteSkill verification requires at least one HTML file")
        taste_result = bounded_run([taste, "check", "--url", html_files[0], "--sizes", "1440x900,390x844"], timeout)
        if taste_result.returncode:
            raise CommandFailure("taste_skill_failed", "TasteSkill verification failed; frontend pipeline stopped", details=(taste_result.stderr or taste_result.stdout).strip(), exit_code=taste_result.returncode)
        return emit(True, "frontend", result={"dossier": str(dossier_path), "architect": arch, "builder": build, "impeccable": detect.stdout.strip(), "taste_skill": taste_result.stdout.strip()})
    except (CommandFailure, OSError) as exc:
        if not isinstance(exc, CommandFailure):
            exc = CommandFailure("io_error", "Could not write/read frontend dossier", details=str(exc))
        return emit(False, "frontend", error=exc)


def cmd_stageshow(args: argparse.Namespace) -> int:
    try:
        result = bounded_run(["stageshow", "film", args.topic_or_scenario, "--gate"], args.timeout)
        if result.returncode:
            raise CommandFailure("stageshow_failed", "Stageshow rehearsal gate failed", details=(result.stderr or result.stdout).strip(), exit_code=result.returncode)
        return emit(True, "stageshow", result=result.stdout.strip())
    except CommandFailure as exc:
        return emit(False, "stageshow", error=exc)


def cmd_init(args: argparse.Namespace) -> int:
    try:
        agents = get_agents()
        if args.fix:
            for agent in agents:
                name = agent.get("name")
                tab, pane = str(agent.get("tab_id", "")), str(agent.get("pane_id", ""))
                is_coordinator_pane = (tab == "w2" and pane == "p1") or pane == "w2:p1"
                if (not name or str(name).lower() in {"unknown", "unnamed"}) and is_coordinator_pane:
                    rename = bounded_run(["herdr", "agent", "rename", "w2:p1", "coordinator"], 20)
                    if rename.returncode:
                        raise CommandFailure("topology_fix_failed", "Could not name w2:p1 coordinator", details=(rename.stderr or rename.stdout).strip(), exit_code=rename.returncode)
                    agent["name"] = "coordinator"
                    break
        workspace = current_workspace(agents)
        if workspace is None and len({str(a.get("workspace_id") or a.get("workspace") or "") for a in agents}) > 1:
            raise CommandFailure("workspace_ambiguous", "Could not determine the current workspace; set HERDR_WORKSPACE")
        scoped = filter_workspace(agents, workspace)
        return emit(True, "init", result={"workspace": workspace, "fixed": bool(args.fix), "agents": scoped})
    except CommandFailure as exc:
        return emit(False, "init", error=exc)


def cmd_worktree(args: argparse.Namespace) -> int:
    try:
        result = bounded_run(["herdr", "worktree", args.action, *args.args], args.timeout)
        if result.returncode:
            raise CommandFailure("worktree_failed", f"Worktree {args.action} failed ({result.returncode})", details=(result.stderr or result.stdout).strip(), exit_code=result.returncode)
        return emit(True, "worktree", result=result.stdout.strip())
    except CommandFailure as exc:
        return emit(False, "worktree", error=exc)


def add_json(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--json", action="store_true", help="emit a structured JSON result")


def positive_timeout(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("timeout must be a number of seconds") from exc
    if parsed <= 0 or parsed > MAX_TIMEOUT:
        raise argparse.ArgumentTypeError(f"timeout must be between 0 and {MAX_TIMEOUT} seconds")
    return parsed


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="herdr-swarm", description="Workspace-aware Herdr agent orchestration")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("status", help="show active agents"); p.add_argument("--workspace"); add_json(p); p.set_defaults(func=cmd_status)
    p = sub.add_parser("prompt", help="send a prompt to an agent"); p.add_argument("agent"); p.add_argument("prompt_text"); p.add_argument("--wait", action="store_true"); p.add_argument("--timeout", type=positive_timeout, default=60); add_json(p); p.set_defaults(func=cmd_prompt)
    p = sub.add_parser("read", help="read agent output"); p.add_argument("agent"); p.add_argument("--source", default="recent-unwrapped"); p.add_argument("--lines", type=int, default=50); add_json(p); p.set_defaults(func=cmd_read)
    p = sub.add_parser("wait", help="wait for an agent state"); p.add_argument("agent"); p.add_argument("--until", choices=("idle", "done"), default="idle"); p.add_argument("--timeout", type=positive_timeout, default=60); add_json(p); p.set_defaults(func=cmd_wait)
    p = sub.add_parser("interrupt", help="interrupt an agent"); p.add_argument("agent"); add_json(p); p.set_defaults(func=cmd_interrupt)
    p = sub.add_parser("focus", help="focus an agent or tab"); p.add_argument("agent_or_tab"); add_json(p); p.set_defaults(func=cmd_focus)
    p = sub.add_parser("zoom", help="toggle zoom for an agent or pane"); p.add_argument("agent_or_pane"); add_json(p); p.set_defaults(func=cmd_zoom)
    p = sub.add_parser("broadcast", help="send a prompt to the default agent group"); p.add_argument("text"); p.add_argument("--timeout", type=positive_timeout, default=60); add_json(p); p.set_defaults(func=cmd_broadcast)
    p = sub.add_parser("pipeline", help="run the guarded SWE pipeline"); p.add_argument("task"); p.add_argument("--timeout", type=positive_timeout, default=180); add_json(p); p.set_defaults(func=cmd_pipeline)
    p = sub.add_parser("frontend", help="run the guarded frontend pipeline"); p.add_argument("topic"); p.add_argument("kind", nargs="?", default="software"); p.add_argument("type", nargs="?", default="software"); p.add_argument("--timeout", type=positive_timeout, default=180); add_json(p); p.set_defaults(func=cmd_frontend)
    p = sub.add_parser("stageshow", help="run the Stageshow gate"); p.add_argument("topic_or_scenario"); p.add_argument("--timeout", type=positive_timeout, default=120); add_json(p); p.set_defaults(func=cmd_stageshow)
    p = sub.add_parser("init", help="inspect and optionally heal the topology"); p.add_argument("--fix", action="store_true"); add_json(p); p.set_defaults(func=cmd_init)
    p = sub.add_parser("worktree", help="manage Herdr worktrees"); p.add_argument("action", choices=("create", "list", "remove")); p.add_argument("args", nargs="*"); p.add_argument("--timeout", type=positive_timeout, default=60); add_json(p); p.set_defaults(func=cmd_worktree)
    return parser


def main(argv: list[str] | None = None) -> int:
    global JSON_MODE
    parser = build_parser()
    args = parser.parse_args(argv)
    JSON_MODE = bool(getattr(args, "json", False))
    if getattr(args, "lines", 1) < 1:
        parser.error("--lines must be at least 1")
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
