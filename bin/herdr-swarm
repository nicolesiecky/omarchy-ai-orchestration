#!/usr/bin/env python3
"""Herdr Swarm Management and Inter-Agent Dispatch CLI."""
import sys
import json
import shutil
import subprocess

def run_herdr(*args):
    res = subprocess.run(["herdr", *args], capture_output=True, text=True)
    if res.returncode != 0:
        return None, res.stderr or res.stdout
    try:
        return json.loads(res.stdout), None
    except Exception:
        return res.stdout, None

def cmd_status():
    data, err = run_herdr("agent", "list")
    if err or not isinstance(data, dict):
        print("Herdr server is not running or no agents active.", file=sys.stderr)
        return 1

    agents = data.get("result", {}).get("agents", [])
    if not agents:
        print("No active agents found in Herdr.")
        return 0

    print("┌────────────────┬─────────────┬──────────┬──────────────┬───────────────────────────┐")
    print("│ Agent Name     │ CLI Engine  │ Tab      │ Pane ID      │ Live Status               │")
    print("├────────────────┼─────────────┼──────────┼──────────────┼───────────────────────────┤")
    for a in sorted(agents, key=lambda x: (x.get("tab_id", ""), x.get("name", ""))):
        name = a.get("name") or a.get("agent", "unknown")
        engine = a.get("agent", "unknown")
        tab = a.get("tab_id", "")
        pane = a.get("pane_id", "")
        status = a.get("agent_status", "unknown")
        
        # Color coding for terminal
        status_color = status
        if status == "idle":
            status_color = f"\033[32m● {status}\033[0m"
        elif status == "working":
            status_color = f"\033[33m⚡ {status}\033[0m"
        elif status == "blocked":
            status_color = f"\033[31m✋ {status}\033[0m"
        elif status == "done":
            status_color = f"\033[36m✓ {status}\033[0m"
            
        print(f"│ {name:<14} │ {engine:<11} │ {tab:<8} │ {pane:<12} │ {status_color:<34} │")
    print("└────────────────┴─────────────┴──────────┴──────────────┴───────────────────────────┘")
    return 0

def cmd_prompt(target, prompt, timeout_ms="60000"):
    print(f"Dispatching to [{target}]... (timeout: {int(timeout_ms)//1000}s)", file=sys.stderr)
    res = subprocess.run(
        ["herdr", "agent", "prompt", target, prompt, "--wait", "--timeout", str(timeout_ms)],
        capture_output=True,
        text=True
    )
    if res.returncode != 0:
        print(f"Prompt failed: {res.stderr or res.stdout}", file=sys.stderr)
        return res.returncode

    # Read output
    read_res = subprocess.run(
        ["herdr", "agent", "read", target, "--source", "recent-unwrapped", "--lines", "120"],
        capture_output=True,
        text=True
    )
    print(read_res.stdout.strip())
    return 0

def cmd_focus(target):
    # Try agent focus first
    res = subprocess.run(["herdr", "agent", "focus", target], capture_output=True, text=True)
    if res.returncode == 0:
        print(f"Focused agent [{target}].")
        return 0
    # Try tab focus
    res = subprocess.run(["herdr", "tab", "focus", target], capture_output=True, text=True)
    if res.returncode == 0:
        print(f"Focused tab [{target}].")
        return 0
    print(f"Target [{target}] not found.", file=sys.stderr)
    return 1

def cmd_zoom(target):
    # Lookup agent to find its pane_id
    data, err = run_herdr("agent", "get", target)
    if err or not isinstance(data, dict):
        # Fallback to direct pane id
        pane_id = target
    else:
        pane_id = data.get("result", {}).get("agent", {}).get("pane_id", target)

    res = subprocess.run(["herdr", "pane", "zoom", "--pane", pane_id, "--toggle"], capture_output=True, text=True)
    if res.returncode == 0:
        print(f"Toggled zoom for [{target}] (pane {pane_id}).")
        return 0
    print(f"Failed to toggle zoom for [{target}]: {res.stderr or res.stdout}", file=sys.stderr)
    return 1

def cmd_worktree(action, *args):
    res = subprocess.run(["herdr", "worktree", action, *args], capture_output=True, text=True)
    if res.returncode == 0:
        print(res.stdout.strip())
        return 0
    print(f"Worktree error: {res.stderr or res.stdout}", file=sys.stderr)
    return res.returncode

def cmd_frontend(query, site_kind="software", page_type="software"):
    print("=" * 70)
    print(f"🎨 INITIATING ANTI-SLOP FRONTEND CRAFT PIPELINE")
    print(f"Topic: {query} | Kind: {site_kind} | Type: {page_type}")
    print("=" * 70)

    # Stage 1: Inspiration Scout (21st.dev, Godly, Awwwards, Land-book, Dribbble)
    print("\n[Stage 1/4] 🔍 Running Inspiration Scout & TasteSkill Dealt Tokens...", file=sys.stderr)
    dossier_res = subprocess.run(
        ["inspiration-scout", query, site_kind, page_type],
        capture_output=True,
        text=True
    )
    dossier = dossier_res.stdout.strip()
    
    with open("INSPIRATION_DOSSIER.md", "w") as f:
        f.write(dossier)
    print("✓ INSPIRATION_DOSSIER.md generated with TasteSkill dealt tokens & UI/UX Pro Max intelligence.")

    # Stage 2: Architecture & Layout Structuring via Architect (Codex GPT-6-Luna)
    print("\n[Stage 2/4] 🏛️ Structuring Layout & Hierarchy via Architect (Codex)...", file=sys.stderr)
    arch_prompt = f"""FRONTEND CRAFT SPECIFICATION FOR: {query}
Refer to INSPIRATION_DOSSIER.md.
CRITICAL TASTESKILL 2.5 RULES:
1. One section per screen (exact 1440x900 and 390x844).
2. Equal edges left/right (.wrap).
3. Quiet micro-interactions (translateY -2px, image scale 1.02 in frame).
4. STRICT BAN ON PURPLE / LAVENDER in palette!
5. Real product UI or clean typography, NO generic AI slop.

Provide the exact HTML structure, CSS variables, and layout sections."""
    cmd_prompt("architect", arch_prompt, timeout_ms="120000")

    # Read architect output
    read_arch = subprocess.run(["herdr", "agent", "read", "architect", "--source", "recent-unwrapped", "--lines", "60"], capture_output=True, text=True)
    arch_summary = read_arch.stdout.strip()

    # Stage 3: Builder (OpenCode GLM-5.3-Flash Free) Implementation
    print("\n[Stage 3/4] 🔨 Delegating Frontend Implementation to Builder (OpenCode)...", file=sys.stderr)
    builder_prompt = f"""TASK: Implement the frontend for: {query}
Read INSPIRATION_DOSSIER.md for dealt color palettes and typography.
ARCHITECTURE PLAN:
{arch_summary}

ANTI-SLOP INVARIANTS:
- No purple/lavender gradients.
- Strict 1 section per 1440x900 screen.
- High-contrast typography with authentic hierarchy.
Implement index.html and style.css (or components)."""
    cmd_prompt("builder", builder_prompt, timeout_ms="180000")

    # Stage 4: Anti-Slop Verification Gate
    print("\n[Stage 4/4] 🛡️ Running Dual Verification Gate (Impeccable Detect & TasteSkill)...", file=sys.stderr)
    impeccable_res = subprocess.run(["impeccable", "detect", "--json", "."], capture_output=True, text=True)
    if impeccable_res.returncode == 0:
        print("✓ Impeccable Anti-Slop Check: PASSED (No AI slop patterns detected).")
    else:
        print(f"⚠ Impeccable Warnings:\n{impeccable_res.stdout}")

    html_find = subprocess.run(["find", ".", "-maxdepth", "2", "-name", "*.html"], capture_output=True, text=True).stdout.splitlines()
    if html_find:
        html_file = html_find[0]
        print(f"Running TasteSkill check on {html_file}...")
        subprocess.run(["taste-skill", "check", "--url", html_file, "--sizes", "1440x900,390x844"], check=False)

    print("\n" + "=" * 70)
    print("✅ FRONTEND CRAFT PIPELINE COMPLETE! Quality guaranteed at figma.com/x.ai bar.")
    print("=" * 70)
    return 0

def cmd_pipeline(task):
    print("=" * 70)
    print(f"🚀 INITIATING HERDR MULTI-AGENT SWE PIPELINE")
    print(f"Task: {task}")
    print("=" * 70)

    # Stage 1: Architect (Codex GPT-6-Luna)
    print("\n[Stage 1/4] 🏛️ Consulting Architect (Codex GPT-6-Luna) for Architecture & Contracts...", file=sys.stderr)
    arch_prompt = f"TASK: {task}\n\nOutline the architectural interface contracts, function signatures, data types, and potential adversarial edge cases. Keep it concise, concrete, and directly implementable."
    cmd_prompt("architect", arch_prompt, timeout_ms="120000")

    # Read architect output
    read_arch = subprocess.run(["herdr", "agent", "read", "architect", "--source", "recent-unwrapped", "--lines", "60"], capture_output=True, text=True)
    arch_summary = read_arch.stdout.strip()

    # Stage 2: Builder (OpenCode GLM-5.3-Flash Free)
    print("\n[Stage 2/4] 🔨 Delegating Implementation to Builder (OpenCode GLM-5.3-Flash Free)...", file=sys.stderr)
    builder_prompt = f"TASK: {task}\n\nARCHITECTURE CONTRACTS FROM ARCHITECT:\n{arch_summary}\n\nPlease implement the necessary files, functions, and tests according to the architectural plan."
    cmd_prompt("builder", builder_prompt, timeout_ms="180000")

    # Stage 3: Sentinel (Oh-My-Pi Nemotron 3.5 Super VL)
    print("\n[Stage 3/4] 🛡️ Running Quality Gate & Test Runner via Sentinel (Oh-My-Pi)...", file=sys.stderr)
    sentinel_prompt = f"Run unit tests and analyze test coverage and syntax checks for task: {task}. Report exact test pass/fail counts."
    cmd_prompt("sentinel", sentinel_prompt, timeout_ms="90000")

    # Stage 4: Reviewer (Antigravity Gemini)
    print("\n[Stage 4/4] 🔍 Performing Code Review & Security Audit via Reviewer (Antigravity Gemini)...", file=sys.stderr)
    reviewer_prompt = f"Perform a strict code review and security audit for task: {task}. Check for edge cases, clean architecture, and security vulnerabilities."
    cmd_prompt("reviewer", reviewer_prompt, timeout_ms="90000")

    print("\n" + "=" * 70)
    print("✅ HERDR SWE PIPELINE COMPLETE! Ready for Coordinator synthesis.")
    print("=" * 70)
    return 0

def cmd_broadcast(prompt):
    agents = ["builder", "scout", "analyst"]
    print(f"Broadcasting to Free Swarm {agents}...", file=sys.stderr)
    for a in agents:
        subprocess.run(["herdr", "agent", "prompt", a, prompt], capture_output=True, text=True)
    print("Prompts delivered. Use 'herdr-swarm status' to track progress.")
    return 0

def cmd_init():
    """Ensure the complete 3-tab 9-agent workspace topology is initialized."""
    print("Checking Herdr swarm topology...", file=sys.stderr)
    data, err = run_herdr("agent", "list")
    if err or not isinstance(data, dict):
        print("Herdr server is not running.", file=sys.stderr)
        return 1
        
    agents = data.get("result", {}).get("agents", [])
    active_names = {a.get("name") or a.get("agent"): a for a in agents}
    
    # Check if roster is already healthy
    expected = ["builder", "scout", "analyst", "oracle", "architect", "strategist", "sentinel", "reviewer", "coordinator"]
    missing = [name for name in expected if name not in active_names]
    
    if not missing:
        print("Herdr Swarm is already fully initialized with all 9 agents active!\n")
        return cmd_status()
        
    print(f"Active agents: {list(active_names.keys())}")
    print(f"Missing agents from topology: {missing}")
    return cmd_status()

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print("Herdr Swarm CLI Helper\n")
        print("Usage:")
        print("  herdr-swarm status                        Show live roster status table")
        print("  herdr-swarm init                          Check and verify swarm topology")
        print("  herdr-swarm prompt <agent> <text>         Send prompt to an agent and wait for output")
        print("  herdr-swarm focus <agent|tab>             Focus target agent or tab")
        print("  herdr-swarm zoom <agent|pane>             Toggle full-screen zoom on an agent's pane")
        print("  herdr-swarm broadcast <text>              Broadcast prompt across Free Swarm agents")
        print("  herdr-swarm pipeline \"<task description>\" Run 4-stage automated SWE pipeline")
        print("  herdr-swarm frontend \"<topic>\" [kind]    Run automated Anti-Slop Frontend Craft pipeline")
        print("  herdr-swarm worktree <create|list|remove> Manage isolated git worktree workspaces")
        return 0

    cmd = sys.argv[1]
    if cmd == "status":
        return cmd_status()
    elif cmd == "init":
        return cmd_init()
    elif cmd == "frontend":
        if len(sys.argv) < 3:
            print("Usage: herdr-swarm frontend \"<topic>\" [kind] [type]", file=sys.stderr)
            return 1
        query = sys.argv[2]
        kind = sys.argv[3] if len(sys.argv) > 3 else "software"
        page_type = sys.argv[4] if len(sys.argv) > 4 else "software"
        return cmd_frontend(query, kind, page_type)
    elif cmd == "zoom":
        if len(sys.argv) < 3:
            print("Usage: herdr-swarm zoom <agent|pane>", file=sys.stderr)
            return 1
        return cmd_zoom(sys.argv[2])
    elif cmd == "pipeline":
        if len(sys.argv) < 3:
            print("Usage: herdr-swarm pipeline \"<task description>\"", file=sys.stderr)
            return 1
        return cmd_pipeline(" ".join(sys.argv[2:]))
    elif cmd == "broadcast":
        if len(sys.argv) < 3:
            print("Usage: herdr-swarm broadcast \"<text>\"", file=sys.stderr)
            return 1
        return cmd_broadcast(" ".join(sys.argv[2:]))
    elif cmd == "worktree":
        if len(sys.argv) < 3:
            print("Usage: herdr-swarm worktree <create|list|remove> [args...]", file=sys.stderr)
            return 1
        return cmd_worktree(sys.argv[2], *sys.argv[3:])
    elif cmd == "prompt":
        if len(sys.argv) < 4:
            print("Usage: herdr-swarm prompt <agent> <text> [timeout_ms]", file=sys.stderr)
            return 1
        target = sys.argv[2]
        prompt = sys.argv[3]
        timeout_ms = sys.argv[4] if len(sys.argv) > 4 else "60000"
        return cmd_prompt(target, prompt, timeout_ms)
    elif cmd == "focus":
        if len(sys.argv) < 3:
            print("Usage: herdr-swarm focus <agent|tab>", file=sys.stderr)
            return 1
        return cmd_focus(sys.argv[2])
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main())
